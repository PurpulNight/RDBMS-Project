# ==========================================
# MySQL Database Configuration
# ==========================================
PORT=3000

# MySQL Server Host (e.g. localhost, 127.0.0.1, or cloud host)
DB_HOST=localhost

# MySQL Server Port (Default: 3306)
DB_PORT=3306

# MySQL Server Username (Default in XAMPP / local is root)
DB_USER=root

# MySQL Server Password (Leave blank for default XAMPP, or set your password)
DB_PASSWORD=

# MySQL Database Name (Will be auto-created if it doesn't exist)
DB_NAME=library_db
